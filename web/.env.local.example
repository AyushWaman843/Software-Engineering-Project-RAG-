# Frontend settings for the Next.js app.
#
# With `npm run dev` from the repo root, the root .env already feeds all of
# these, so you normally do not need this file. Copy it to web/.env.local
# (git-ignored) for `next build` / `next start` deployments, or to override a
# value for the UI only.
#
# One KEY=value per line, no quotes, no trailing comments.

# Must equal API_KEY in the root .env.
INTERNAL_API_KEY=

# Same value as INTERNAL_PROXY_SECRET in the root .env (leave blank if unused).
INTERNAL_PROXY_SECRET=

# Where the Next.js proxy reaches the Flask API.
BACKEND_URL=http://127.0.0.1:5000

# Supabase: same project as the root .env (anon key is safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never prefix with NEXT_PUBLIC_: used by the demo sign-in and
# entitlement routes.
SUPABASE_SERVICE_KEY=

# Optional: HTTP basic auth on the whole UI.
# APP_PASSWORD=

# Optional: public site URL used in auth email links (production).
# NEXT_PUBLIC_SITE_URL=

# Optional: Cloudflare Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_REQUIRED=0

# Optional: sign in automatically as a demo user (run create_demo_user.py first).
# NEXT_PUBLIC_DEMO_AUTO_LOGIN=1
# NEXT_PUBLIC_DEMO_EMAIL=
# NEXT_PUBLIC_DEMO_PASSWORD=
