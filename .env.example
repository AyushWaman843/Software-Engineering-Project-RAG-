FLASK_ENV=development
FLASK_SECRET_KEY=
API_KEY=
INTERNAL_PROXY_SECRET=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

DEEPSEEK_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PREMIUM_ENABLED=1
FREE_SCANS_PER_USER=1
PILOT_SCANS_PER_DAY=1

# Optional: another OpenAI-compatible endpoint, if api.deepseek.com is blocked on
# your network. The key goes in DEEPSEEK_API_KEY and the model in DEEPSEEK_MODEL.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional RAG tuning (defaults shown). RAG_FULL_TEXT_MAX_CHARS is the old hard cap:
# lowering it sends only retrieved passages for long policies and saves tokens, but
# check it against your model first (python rag_eval.py --inspect / --live).
# RAG_FULL_TEXT_MAX_CHARS=100000
# RAG_EVIDENCE_BUDGET_CHARS=24000
# RAG_TOP_K=4
# RAG_EVIDENCE_CHECKS=1
# DEEPSEEK_MAX_TOKENS=8192
# DEEPSEEK_JSON_MODE=0
# LLM_CACHE_MAX_ENTRIES=256

# Paid scans below 80% average confidence get a second LLM pass with extra site pages
# (one more API call). 0 turns that off.
# CONFIDENCE_REFINEMENT_ENABLED=1

# Optional bot protection; configure both server keys when enabling.
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=0
